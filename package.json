{
  "name": "ai-support-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI Support Agent — diagnoses client-reported GitHub/Jira issues with repo-aware RAG and produces a structured, citable triage report.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:intents": "vitest run src/lib/support/__tests__/intent.test.ts src/lib/support/__tests__/intent-integration.test.ts",
    "test:predeploy": "node scripts/predeploy-check.mjs",
    "test:watch": "vitest",
    "ingest": "tsx --conditions=react-server scripts/ingest-cli.ts",
    "vendor:cyware-specs": "tsx --conditions=react-server scripts/vendor-cyware-specs.ts",
    "typecheck": "tsc --noEmit",
    "mcp:check": "node scripts/check-mcp.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:ide-api": "node scripts/test-ide-api.mjs",
    "test:production:providers": "node scripts/test-external-integrations.mjs",
    "seed:integration-test": "node scripts/seed-integration-test-content.mjs",
    "build:app": "npm run build",
    "deploy:preview": "vercel",
    "deploy:prod": "vercel --prod && node scripts/ensure-public-deploy.mjs",
    "deploy:public": "node scripts/ensure-public-deploy.mjs",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.23.0",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/redis": "^1.38.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^4.7.1",
    "server-only": "^0.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
