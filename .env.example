# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.
# Every value below is OPTIONAL: with no keys set, the app runs fully on mock
# connectors + a local in-memory vector store, so you can demo it offline.

# --- OpenAI (embeddings + reasoning) ---
# Without this, analysis falls back to a deterministic heuristic engine.
OPENAI_API_KEY=
# Optional model overrides.
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Pinecone (vector DB for RAG) ---
# Without PINECONE_API_KEY, ingestion/retrieval use an in-memory cosine store.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=support-agent-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Optional base namespace prefix applied to every source namespace.
PINECONE_NAMESPACE=

# --- GitHub (repo + issues connector) ---
# A classic or fine-grained token with `repo` read scope. Without it, a mock
# GitHub connector with realistic sample data is used automatically.
GITHUB_TOKEN=
# owner/name used when the user does not provide a repo URL.
DEFAULT_GITHUB_REPO=vercel/next.js

# --- Jira (tickets connector) ---
# Without these three, a mock Jira connector with sample tickets is used.
# Custom Jira configuration in Settings is Developer/Admin-only (server-enforced).
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
# Optional: scope ticket search + default project for created issues.
JIRA_PROJECT_KEY=

# --- Cyware Intel Exchange (CTIX) ---
# Required: base URL + Access ID + Secret Key (HMAC). No API key.
# Where: CTIX → Administration → Integration Management → Open API
CTIX_BASE_URL=
CTIX_CLIENT_ID=
CTIX_CLIENT_SECRET=
CTIX_AUTH_TYPE=ctix_open_api

# --- Cyware CSAP ---
# Required: base URL + API key. No Access ID / Secret Key.
# Where: CSAP Analyst Portal → Settings → API / Open API
CSAP_BASE_URL=
CSAP_API_KEY=
CSAP_AUTH_TYPE=api_key

# --- Cyware CFTR ---
# Required: base URL + API key
# Where: CFTR → Administration → API Settings
CFTR_BASE_URL=
CFTR_API_KEY=
CFTR_AUTH_TYPE=api_key

# --- Cyware Orchestrate ---
# Required: base URL + API key (or app token as API key)
# Where: Orchestrate → Settings → API / Apps
ORCHESTRATE_BASE_URL=
ORCHESTRATE_API_KEY=
ORCHESTRATE_AUTH_TYPE=api_key

# --- MCP servers (remote HTTP/SSE only) ---
# JSON array: [{"name":"x","url":"https://...","transport":"http","headers":{"Authorization":"Bearer ..."},"allowWrites":false}]
MCP_SERVER_CONFIG_JSON=

# --- MCP stdio stubs (see mcp/README.md and .cursor/mcp.json.example) ---
LOG_PROVIDER=
LOG_API_KEY=
LOG_BASE_URL=

# --- Auto-import on first request (bundled Cyware specs + CQL docs) ---
# Set AUTO_IMPORT_LIVE_CYWARE=true to fetch live docs instead of data/cyware-specs/
AUTO_IMPORT_LIVE_CYWARE=false
AUTO_IMPORT_CQL=true
# Sync Confluence/mock enterprise knowledge into RAG when index is empty (default on).
AUTO_IMPORT_ENTERPRISE_KNOWLEDGE=true

# --- Optional durable backends (offline-first without them) ---
# Postgres — required for production RBAC + credential persistence on Vercel
DATABASE_URL=
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ENCRYPTION_KEY=

# --- Vercel (logs + deployment intelligence) ---
# Without VERCEL_TOKEN, investigation uses realistic mock logs/deployments.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# --- App ---
APP_ENV=development
# Public origin of this deployment (required for Slack Event Subscriptions URL).
# Example: https://ai-support-agent-ecru.vercel.app
APP_BASE_URL=http://localhost:3000
# Used by scripts/vercel-env-push.mjs only — production URL pushed to Vercel (never localhost).
VERCEL_APP_BASE_URL=https://your-app.vercel.app

# --- Auth0 (enterprise login — optional; omit to run without login) ---
# Create a Regular Web Application in Auth0. Callback: {APP_BASE_URL}/auth/callback
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Set AUTH_DISABLED=true to force auth off even when Auth0 vars are present.
AUTH_DISABLED=false
DEFAULT_ORG_ID=default

# --- Encrypted integration credential store (Settings → Integrations) ---
# 32+ char random string. Required to save Slack/Jira/Zendesk/Confluence creds in UI
# instead of env vars. Can reuse AUTH0_SECRET in dev only — use a dedicated key in prod.
INTEGRATION_SECRET_KEY=

# =============================================================================
# Slack bot — Event Subscriptions → Request URL: {APP_BASE_URL}/api/slack/events
# =============================================================================
# Create app: https://api.slack.com/apps → Create New App → From scratch
#
# 1) Basic Information → copy Signing Secret → SLACK_SIGNING_SECRET
# 2) OAuth & Permissions → Bot Token Scopes (minimum for /api/slack/events):
#      app_mentions:read   — @mention the bot in a channel
#      chat:write          — bot replies in thread
#      channels:history    — read public channel thread context (optional but recommended)
#      groups:history      — private channels (optional)
# 3) Install App to Workspace → copy Bot User OAuth Token → SLACK_BOT_TOKEN
# 4) Event Subscriptions → Enable → Request URL:
#      {APP_BASE_URL}/api/slack/events
#    Subscribe to bot events: app_mention, message.channels (and message.groups if needed)
# 5) Interactivity (approval buttons) → Request URL:
#      {APP_BASE_URL}/api/slack/interactions
#
# Required (env OR Settings → Integrations → Slack encrypted store):
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
#
# Optional Slack metadata (Settings UI or env — not secrets):
# SLACK_DEFAULT_CHANNEL_ID=C01234567
# SLACK_TEAM_ID=T01234567
#
# Production also needs:
#   DATABASE_URL          — persist slack_conversations + thread memory (Neon)
#   OPENAI_API_KEY        — AI investigation replies (heuristic fallback if unset)
#
# /api/slack/events is public (signature-verified, no Auth0). Do NOT use
# /api/integrations/slack/events for Slack Event Subscriptions unless you add
# that path to middleware public API prefixes.

# /api/slack/events is public (signature-verified, no Auth0). Do NOT use
# /api/integrations/slack/events for Slack Event Subscriptions unless you add
# that path to middleware public API prefixes.

# =============================================================================
# Zendesk Support — REST API (no inbound webhook URL required)
# =============================================================================
# Used for: ticket search/read in investigations, link tickets, approval-gated
# customer replies, internal notes, and ticket creation.
#
# Setup:
# 1) Zendesk Admin Center → Apps and integrations → Zendesk API
# 2) Enable Token Access (Settings → API if not already on)
# 3) Add API token → copy token → ZENDESK_API_TOKEN
# 4) Use an agent/admin email that owns the token → ZENDESK_EMAIL
# 5) Subdomain from your help desk URL:
#      https://YOUR-SUBDOMAIN.zendesk.com  →  ZENDESK_SUBDOMAIN=YOUR-SUBDOMAIN
#
# Required (env OR Settings → Integrations → Zendesk encrypted store):
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
#
# App API routes (Auth0 session required):
#   GET  /api/integrations/zendesk/tickets?q=search+terms
#   POST /api/integrations/zendesk/tickets   { "ticketId": "12345" }
#   POST /api/integrations/zendesk/actions   link, draft, request_reply, request_note, request_create
#
# Zendesk agent permissions (recommended):
#   Read:   tickets, users, search
#   Write:  add comments (public + internal), create tickets — always approval-gated in app
#
# Production also needs:
#   INTEGRATION_SECRET_KEY  — if saving via Settings UI instead of env
#   DATABASE_URL            — investigation_links (Zendesk ticket ↔ investigation)
#   OPENAI_API_KEY          — draft customer replies / internal notes (optional)

# =============================================================================
# Confluence — docs search + RAG knowledge sync
# =============================================================================
# Used for: page search/read, knowledge source sync into RAG, investigation citations.
#
# Setup (Atlassian Cloud):
# 1) https://id.atlassian.com/manage-profile/security/api-tokens → Create API token
# 2) CONFLUENCE_EMAIL = your Atlassian account email
# 3) CONFLUENCE_API_TOKEN = the token from step 1
# 4) CONFLUENCE_BASE_URL = site root WITHOUT /wiki
#      Example: https://your-org.atlassian.net
# 5) CONFLUENCE_SPACE_KEY = optional space key to limit search/sync (e.g. SUP, ENG)
#
# Required (env OR Settings → Integrations → Confluence encrypted store):
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Optional — limit search/sync to one space:
CONFLUENCE_SPACE_KEY=
#
# App API routes (Auth0 session required):
#   GET  /api/integrations/confluence/pages?q=runbook
#   POST /api/integrations/confluence/pages   { "pageId": "123456" }
#   POST /api/integrations/confluence/sync      sync space into knowledge index
#   Settings → Knowledge sources                 view indexed sources
#
# RAG / knowledge indexing (recommended for live Confluence):
#   OPENAI_API_KEY              — embeddings for ingested pages
#   PINECONE_API_KEY            — vector store (in-memory fallback if unset)
#   AUTO_IMPORT_ENTERPRISE_KNOWLEDGE=true   — auto-bootstrap on first request (default on)
#
# Production also needs:
#   INTEGRATION_SECRET_KEY  — if saving via Settings UI instead of env
#   DATABASE_URL            — knowledge_sources metadata (Neon)

# --- Build App (generated Next.js apps) ---
# On Vercel production: real builds run via Vercel Deploy API when VERCEL_TOKEN is set.
# Optional remote worker URL (POST { projectId, files }) for install/build off-serverless.
BUILD_APP_BUILD_WORKER_URL=
# Force local npm even on Vercel serverless (advanced — may timeout).
BUILD_APP_REAL_COMMANDS=false
# Opt-in mock builds on Vercel when no token/worker (not recommended for production).
BUILD_APP_MOCK_ON_VERCEL=false

# --- Test / CI ---
# TEST_MODE=true bypasses Auth0 enforcement (used by Playwright webServer only — never on Vercel).
TEST_MODE=
NEXT_PUBLIC_TEST_MODE=

# --- Safety ---
# When "true", ALL write actions are blocked regardless of approval. Default
# false: writes run only with explicit per-action approval. Reads always allowed.
SUPPORT_AGENT_READ_ONLY=false
