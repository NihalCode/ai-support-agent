# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.
# Every value below is OPTIONAL: with no keys set, the app runs fully on mock
# connectors + a local in-memory vector store, so you can demo it offline.

# --- OpenAI (embeddings + reasoning) ---
# Without this, analysis falls back to a deterministic heuristic engine.
OPENAI_API_KEY=

# --- Pinecone (vector DB for RAG) ---
# Without PINECONE_API_KEY, ingestion/retrieval use an in-memory cosine store.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=support-agent-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- GitHub (repo + issues connector) ---
# A classic or fine-grained token with `repo` read scope. Without it, a mock
# GitHub connector with realistic sample data is used automatically.
GITHUB_TOKEN=
# owner/name used when the user does not provide a repo URL.
DEFAULT_GITHUB_REPO=vercel/next.js

# --- Jira (tickets connector) ---
# Without these three, a mock Jira connector with sample tickets is used.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Safety ---
# When "true", write actions (comments) are blocked entirely regardless of
# approval. Default false: writes are allowed only with explicit per-action approval.
SUPPORT_AGENT_READ_ONLY=false
